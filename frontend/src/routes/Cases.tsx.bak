import { useCallback, useEffect, useState } from 'react';
import { api } from '../api/client';
import { Alert, Button, Card, CaseStatusChip, EmptyState, ErrorState, LoadingState, RiskBadge } from '../components/ui';
import type { CaseStatus, EvidenceItemResponse, TransactionDetailResponse } from '../types/api';
import { useApiData } from './data';

const nextStatuses: Record<CaseStatus, CaseStatus[]> = { NEW: ['INVESTIGATING'], INVESTIGATING: ['READY_FOR_REVIEW'], READY_FOR_REVIEW: ['APPROVED', 'REJECTED'], APPROVED: ['CLOSED'], REJECTED: ['CLOSED'], CLOSED: [] };
const pct = (value: string) => `${(Number(value) * 100).toFixed(1)}%`;

export function Cases() {
  const caseId = new URLSearchParams(window.location.search).get('case_id');
  const load = useCallback((signal: AbortSignal) => caseId ? api.getCase(caseId, signal) : Promise.resolve(undefined), [caseId]);
  const { data, error, retry } = useApiData(load);
  const [transaction, setTransaction] = useState<TransactionDetailResponse>();
  const [evidence, setEvidence] = useState<EvidenceItemResponse[]>([]);
  const [operation, setOperation] = useState<string>();
  const [operationError, setOperationError] = useState<string>();

  useEffect(() => { if (!data) return; const controller = new AbortController(); api.getTransaction(data.transaction_id, controller.signal).then(setTransaction).catch(() => undefined); api.getEvidence(data.case_id, controller.signal).then(setEvidence).catch(() => undefined); return () => controller.abort(); }, [data]);
  const refreshAll = async () => { setOperationError(undefined); await retry(); if (data) setEvidence(await api.getEvidence(data.case_id)); };
  const run = async (label: string, action: () => Promise<unknown>) => { setOperation(label); setOperationError(undefined); try { await action(); await refreshAll(); } catch (err) { setOperationError(err instanceof Error ? err.message : 'Operation failed'); } finally { setOperation(undefined); } };
  const investigate = () => data && run('Calling backend Gemini investigation and waiting for validated tool-grounded output…', () => api.investigateCase(data.case_id));
  const packageEvidence = () => data && run('Generating versioned evidence package from database facts…', () => api.generateEvidencePackage(data.case_id));
  const recommend = () => data && run('Generating bounded recommendation for human approval…', () => api.generateRecommendation(data.case_id));
  const transition = (status: CaseStatus) => data && run(`Moving case to ${status}…`, () => api.updateCase(data.case_id, status));

  return <><header className="page-heading"><p className="eyebrow">Human review only</p><h1>Transaction investigation</h1><p>Inspect ML risk, run the backend Gemini agent, review traceable evidence, and advance safe workflow states.</p></header>{caseId && !data && !error && <LoadingState label="Opening investigation case…" />}{error && <ErrorState message={error} onRetry={retry} />}{operation && <LoadingState label={operation} />}{operationError && <ErrorState message={operationError} onRetry={() => void refreshAll()} />}{data ? <><div className="investigation-grid"><Card title={`Case ${data.case_id}`}><div className="details"><div><dt>Transaction</dt><dd>{data.transaction_id}</dd></div><div><dt>Status</dt><dd><CaseStatusChip status={data.status} /></dd></div><div><dt>Prediction</dt><dd>{data.prediction}</dd></div><div><dt>Reviewer guardrail</dt><dd>Human Approval Required — no refund, reversal, transfer, or account action has occurred.</dd></div></div><div className="action-row"><Button disabled={!!operation || data.status !== 'NEW'} onClick={investigate}>Investigate</Button><Button disabled={!!operation || data.status !== 'INVESTIGATING'} onClick={packageEvidence}>Build evidence package</Button><Button disabled={!!operation || data.status !== 'INVESTIGATING' || !data.latest_evidence_package} onClick={recommend}>Generate recommendation</Button></div></Card><Card title="ML risk"><div className="risk-panel"><RiskBadge level={data.risk_level} /><strong>{pct(data.risk_score)}</strong><span>Probability {pct(data.risk_score)} · prediction {data.prediction}</span></div>{data.latest_evidence_package?.risk_analysis.some((claim) => claim.content.includes('ML factor')) ? <ul className="evidence-list">{data.latest_evidence_package.risk_analysis.filter((claim) => claim.content.includes('ML factor')).map((claim) => <li key={`${claim.source_id}-${claim.content}`}><span>{claim.content}</span><small>Source: {claim.source} / {claim.source_id}</small></li>)}</ul> : <Alert kind="info">Top model-derived factors become visible after building the evidence package from the audited prediction.</Alert>}</Card></div>{transaction && <Card title="Transaction data"><div className="details details--compact"><div><dt>Amount</dt><dd>{transaction.currency} {Number(transaction.amount).toLocaleString()}</dd></div><div><dt>Status</dt><dd>{transaction.status}</dd></div><div><dt>Customer</dt><dd>{transaction.customer_name} · {transaction.customer_email}</dd></div><div><dt>Merchant</dt><dd>{transaction.merchant_name} · {transaction.merchant_category}</dd></div><div><dt>Disputes</dt><dd>{transaction.disputes_count}</dd></div><div><dt>Synthetic label</dt><dd>Synthetic/demo data only.</dd></div></div></Card>}<Card title="Actual backend progress"><ol className="timeline"><li className="done">Case created from audited ML prediction</li><li className={data.latest_investigation ? 'done' : data.status === 'NEW' ? 'current' : ''}>Gemini backend tool investigation {data.latest_investigation ? `completed with ${data.latest_investigation.tool_calls.length} tool calls` : 'not completed'}</li><li className={data.latest_evidence_package ? 'done' : ''}>Evidence package {data.latest_evidence_package ? `v${data.latest_evidence_package.version} generated` : 'pending'}</li><li className={data.latest_recommendation ? 'done' : ''}>Recommendation {data.latest_recommendation ? 'ready for human approval' : 'pending'}</li></ol></Card><div className="investigation-grid"><Card title="Retrieved evidence items">{evidence.length ? <ul className="evidence-list">{evidence.map((item) => <li key={item.id}><strong>{item.evidence_type}</strong><span>{item.factual_content}</span><small>Evidence {item.id} · Source: {item.source} / {item.source_id} · {item.verification_status}</small></li>)}</ul> : <EmptyState title="No evidence loaded" detail="Case creation builds deterministic database-grounded evidence." />}</Card><Card title="Agent summary and recommendation">{data.latest_investigation ? <><p>{data.latest_investigation.result.risk_summary}</p><div className="badge-row"><CaseStatusChip status={data.latest_investigation.result.recommendation} /><CaseStatusChip status={`Confidence ${(data.latest_investigation.result.confidence * 100).toFixed(0)}%`} /><CaseStatusChip status="Human Approval Required" /></div><h3>Decision factors</h3><ul>{data.latest_investigation.result.risk_factors.map((factor) => <li key={factor}>{factor}</li>)}</ul><h3>Tool calls</h3><ul>{data.latest_investigation.tool_calls.map((call, index) => <li key={`${call.tool_name}-${index}`}>{call.tool_name} → refs {call.evidence_references.join(', ') || 'none'}</li>)}</ul></> : <EmptyState title="Agent has not run" detail="Use Investigate to call the real backend Gemini endpoint. Gemini failures show as retryable errors." />}{data.latest_recommendation && <Alert kind="warning"><strong>{data.latest_recommendation.category}</strong>: {data.latest_recommendation.rationale} Human Approval Required. Financial action executed: {String(data.latest_recommendation.financial_action_executed)}.</Alert>}</Card></div><Card title="Reviewer workflow"><div className="action-row">{nextStatuses[data.status].map((status) => <Button key={status} disabled={!!operation} onClick={() => transition(status)}>Move to {status.replace(/_/g, ' ')}</Button>)}</div><Alert kind="info">Workflow states record reviewer intent only. This UI does not perform refunds, reversals, or money movement.</Alert></Card></> : !caseId && <Card title="Case queue"><EmptyState title="No case selected" detail="Use Investigate from the dashboard or transaction queue to open a database-backed case." /><div className="badge-row"><CaseStatusChip status="NEW" /><CaseStatusChip status="INVESTIGATING" /><CaseStatusChip status="READY_FOR_REVIEW" /></div></Card>}</>;
}
